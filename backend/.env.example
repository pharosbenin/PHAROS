# Copier ce fichier en .env et renseigner les vraies valeurs.
# Ne jamais committer le fichier .env réel (déjà exclu par .gitignore).

# --- Django ---
# En production : générer une clé forte et aléatoire (ex: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=change-moi-en-production
# En production : toujours False
DEBUG=False
# En production : domaine(s) réel(s) séparés par des virgules, ex: api.pharos-benin.com
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données ---
# Si absent, la configuration locale PostgreSQL codée en dur dans settings.py est utilisée.
# En production (Render) : fournie automatiquement par le service PostgreSQL.
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/pharos_db

# --- CORS ---
# Origines autorisées séparées par des virgules (frontend Vercel + local dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://pharos-mu.vercel.app

# --- Africa's Talking (SMS / OTP) ---
AT_USERNAME=sandbox
AT_API_KEY=

# --- FedaPay (paiement Mobile Money / carte) ---
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_BASE_URL=https://sandbox-api.fedapay.com

# --- Frontend ---
# Utilisé pour construire l'URL de retour après paiement FedaPay
FRONTEND_URL=http://localhost:5173

# --- Cloudinary (stockage des photos/documents en production) ---
# Créer un compte gratuit sur cloudinary.com puis copier les 3 valeurs
# depuis le Dashboard. Si laissé vide, les fichiers sont stockés localement
# (comportement du développement local).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
